# Contact form. Without RESEND_API_KEY the form falls back to opening a pre-filled mailto:.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend.
CONTACT_FROM="Abhishek Soni <hello@your-domain.com>"
# Canonical URL for metadata, sitemap and OG (Vercel sets VERCEL_PROJECT_PRODUCTION_URL automatically).
NEXT_PUBLIC_SITE_URL=
